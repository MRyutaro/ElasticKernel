FROM python:3.12-slim

WORKDIR /tmp

# システムライブラリをインストール
RUN apt-get update && apt-get install -y \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# uvのセットアップ
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 依存関係をインストール（PyPIからelastic-kernel==0.0.21をインストール）
RUN uv venv && \
    uv pip install torch --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install "elastic-kernel==0.0.21" && \
    uv run elastic-kernel install && \
    uv run jupyter kernelspec remove python3 -f || true && \
    rm -rf /root/.local/share/jupyter/kernels/python3 \
        /tmp/.venv/share/jupyter/kernels/python3 \
        /usr/local/share/jupyter/kernels/python3 \
        /usr/share/jupyter/kernels/python3 \
        /tmp/.venv/lib/python3.12/site-packages/ipykernel

WORKDIR /app

# パスを設定
ENV PATH="/tmp/.venv/bin:$PATH"

CMD ["jupyter", "lab", "--allow-root", "--ip=0.0.0.0", "--no-browser", "--ServerApp.token=", "--ServerApp.password="]
