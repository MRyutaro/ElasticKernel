FROM python:3.12-slim

WORKDIR /tmp

# システムライブラリをインストール
RUN apt-get update && apt-get install -y \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# uvのセットアップ
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 依存関係をインストール（PyPIからelastic-kernel==0.0.20をインストール）
RUN uv venv && \
    uv pip install elastic-kernel==0.0.20 && \
    uv run elastic-kernel install

WORKDIR /app

# パスを設定
ENV PATH="/tmp/.venv/bin:$PATH"

CMD ["jupyter", "lab", "--allow-root", "--ip=0.0.0.0", "--no-browser", "--ServerApp.token=", "--ServerApp.password="]
