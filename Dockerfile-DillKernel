FROM python:3.12-slim

WORKDIR /tmp

# システムライブラリをインストール
RUN apt-get update && apt-get install -y \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# uvのセットアップ
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 必要なソースコードをコピー
COPY dill_kernel/ ./dill_kernel/

# 依存関係をインストール（dillとjupyter関連のみ）
RUN uv venv && \
    uv pip install dill ipykernel ipython jupyter_client jupyter numpy && \
    PYTHONPATH=/tmp:$PYTHONPATH uv run python -m dill_kernel.command install && \
    uv run jupyter kernelspec remove python3 -f || true && \
    rm -rf /root/.local/share/jupyter/kernels/python3 \
        /tmp/.venv/share/jupyter/kernels/python3 \
        /usr/local/share/jupyter/kernels/python3 \
        /usr/share/jupyter/kernels/python3 \
        /tmp/.venv/lib/python3.12/site-packages/ipykernel

WORKDIR /app

# パスを設定
ENV PATH="/tmp/.venv/bin:$PATH"
ENV PYTHONPATH="/tmp:$PYTHONPATH"

CMD ["jupyter", "lab", "--allow-root", "--ip=0.0.0.0", "--no-browser", "--ServerApp.token=", "--ServerApp.password="]
